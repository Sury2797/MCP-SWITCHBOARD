{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Switchboard",
  "version": "1.0.0",
  "identifier": "com.mcpswitchboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCP Switchboard",
        "width": 1060,
        "height": 740,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../sidecar/dist/server.cjs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNDE4RjExNUExQzIzRDIKUldUU0l4eGFFWTlCZkY2cWRKVkIvU1kza3cyTk5laXBOUjE3czhtaU12TC85dUU2SGdJVmxxUksK",
      "endpoints": [
        "https://github.com/SuryaK999/MCP-SWITCHBOARD/releases/latest/download/latest.json"
      ]
    }
  }
}
