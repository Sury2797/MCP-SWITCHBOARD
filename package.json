{
  "name": "mcp-switchboard",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Universal setup-once MCP switchboard (Streamable HTTP, legacy SSE, STDIO bridge & Cloudflare Tunnel) for Claude Code, Cursor, VS Code, Windsurf, Zed, Claude Desktop & Gemini",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:sidecar": "esbuild sidecar/server.js --bundle --platform=node --target=node20 --format=cjs --outfile=sidecar/dist/server.cjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.sidecar.json --noEmit",
    "sidecar": "node sidecar/server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:signed": "tauri build --config src-tauri/tauri.updater.conf.json",
    "postinstall": "npm --prefix sidecar install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "svelte": "^5.25.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
