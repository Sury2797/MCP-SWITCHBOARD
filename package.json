{
  "name": "mcp-switchboard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Lightweight Svelte 5 + Tauri v2 desktop MCP multiplexer and Cloudflare Tunnel switchboard for Gemini Desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:sidecar": "esbuild sidecar/server.js --bundle --platform=node --target=node20 --format=cjs --outfile=sidecar/dist/server.cjs",
    "sidecar": "node sidecar/server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "postinstall": "npm --prefix sidecar install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "svelte": "^5.25.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
